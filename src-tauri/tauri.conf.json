{
    "productName": "PineFetch",
    "mainBinaryName": "PineFetch",
    "version": "2.7.0",
    "identifier": "com.pinefetch.app",
    "build": {
        "beforeBuildCommand": "npm run sync:design-system && npm run prepare:social-runtime",
        "beforeDevCommand": "npm run prepare:social-runtime && node scripts/dev-server.mjs",
        "additionalWatchFolders": ["../native", "../scripts"],
        "devUrl": "http://127.0.0.1:1420",
        "frontendDist": "../src"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "PineFetch",
                "width": 1400,
                "height": 960,
                "minWidth": 1000,
                "minHeight": 960,
                "resizable": true,
                "useHttpsScheme": true
            }
        ],
        "security": {
            "assetProtocol": { "enable": true, "scope": [] },
            "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data: asset: http://asset.localhost; connect-src 'self' https://api.github.com; media-src 'self' asset: http://asset.localhost https://asset.localhost; frame-src 'none'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "copyright": "Copyright (c) 2026 Oliver Jessner - https://oliverjessner.at\nMIT License",
        "resources": [
            "resources/whisper-runtime",
            "resources/ffmpeg-runtime",
            "resources/deno-runtime",
            "resources/ocr-runtime",
            "resources/social-runtime",
            "icons/icon.png"
        ],
        "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
    }
}
